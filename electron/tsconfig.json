{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": ["../frontend/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "electron": ["../frontend/node_modules/electron/electron.d.ts"]
    },
    "declaration": false,
    "sourceMap": true
  },
  "include": ["main.ts", "preload.ts"]
}

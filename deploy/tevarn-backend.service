# Tevarn Backend —— systemd 服务单元（阶段 3：系统服务化）
#
# 安装：
#   sudo cp deploy/tevarn-backend.service /etc/systemd/system/tevarn-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tevarn-backend
#
# 按实际部署调整 User / WorkingDirectory / ExecStart 路径与端口。

[Unit]
Description=Tevarn Agent OS Backend (FastAPI)
After=network.target
# 可选：依赖本地模型服务时取消注释
# After=llama-server.service
# Wants=llama-server.service

[Service]
Type=simple
User=wuyw
Group=wuyw
WorkingDirectory=/opt/hermes-workspace/tevarn
Environment=PYTHONUNBUFFERED=1
# 审计 P1-C1 / 攻击链 C：反向代理部署必须关闭单用户免登录，
# 否则对端始终是 127.0.0.1，任意外部访问者会被授予 admin。
Environment=TEVARN_SINGLE_USER_MODE=false
# 生产配置走环境变量或 .env（不要在此写密钥）
EnvironmentFile=-/opt/hermes-workspace/tevarn/.env
ExecStart=/opt/hermes-workspace/tevarn/.venv311/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
# 资源与安全加固（个人工作站量级）
MemoryMax=4G
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/wuyw/.tevarn /opt/hermes-workspace/tevarn/backend
PrivateTmp=true

[Install]
WantedBy=multi-user.target

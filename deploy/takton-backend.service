# Takton Backend —— systemd 服务单元（阶段 3：系统服务化）
#
# 安装：
#   sudo cp deploy/takton-backend.service /etc/systemd/system/takton-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now takton-backend
#
# 按实际部署调整 User / WorkingDirectory / ExecStart 路径与端口。

[Unit]
Description=Takton Agent OS Backend (FastAPI)
After=network.target
# 可选：依赖本地模型服务时取消注释
# After=llama-server.service
# Wants=llama-server.service

[Service]
Type=simple
User=wuyw
Group=wuyw
WorkingDirectory=/opt/hermes-workspace/takton
Environment=PYTHONUNBUFFERED=1
# 生产配置走环境变量或 .env（不要在此写密钥）
EnvironmentFile=-/opt/hermes-workspace/takton/.env
ExecStart=/opt/hermes-workspace/takton/.venv311/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
# 资源与安全加固（个人工作站量级）
MemoryMax=4G
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/wuyw/.takton /opt/hermes-workspace/takton/backend
PrivateTmp=true

[Install]
WantedBy=multi-user.target

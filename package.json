{
  "name": "tevarn",
  "version": "0.4.0",
  "private": true,
  "description": "Tevarn - 个人专属 Agent 终端",
  "author": "developer <developer@tevarn.dev>",
  "homepage": "https://github.com/wu1w/tevarn",
  "desktopName": "Tevarn",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "cross-env NEXT_EXPORT=1 npm run build --prefix frontend",
    "build:electron": "cd electron && npx tsc -p tsconfig.json",
    "start": "npm run start --prefix frontend",
    "electron:dev": "concurrently --kill-others \"cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:8090/api NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8090/api npm run dev --prefix frontend\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:prod": "npm run build && npm run build:electron && electron .",
    "ensure:vendor-host": "node scripts/ensure-vendor-host.mjs",
    "pack": "npm run dist:win --prefix frontend -- --dir",
    "dist": "npm run dist --prefix frontend",
    "dist:linux": "npm run dist:linux --prefix frontend",
    "dist:win": "npm run dist:win --prefix frontend",
    "dist:mac": "npm run dist:mac --prefix frontend",
    "prepare:win-python": "node scripts/prepare-win-python.js",
    "lint": "eslint",
    "pack:sanitize": "node scripts/pack-sanitize-env.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.101.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.18.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.tevarn.agent",
    "productName": "Tevarn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json",
      "!**/*.{md,map}",
      "!**/node_modules/**",
      "!**/.env",
      "!**/.env.*",
      "!**/secrets.json",
      "!**/*.db"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "pyproject.toml",
          "requirements.txt",
          "requirements-prod.txt",
          "!**/__pycache__/**",
          "!**/tests/**",
          "!**/*.egg-info/**",
          "!**/*.db",
          "!**/*.db-*",
          "!**/uploads/**",
          "!workspace_state.json",
          "!**/.env",
          "!**/.env.*",
          "!**/*.env",
          "!**/secrets.json",
          "!**/*credentials*",
          "!**/*oauth*token*",
          "!**/.tevarn/**",
          "!**/tevarn.db",
          "!**/tevarn.db-*",
          "!**/workspace_state.json",
          "!**/.computers/**"
        ]
      },
      {
        "from": "tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../vendor/tevarn-kernel-host",
        "to": "tevarn-kernel-host",
        "filter": [
          "tevarn-kernel-host*",
          "README.md",
          "!**/*.pdb"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "public/icon.png",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "../.venv",
          "to": "backend/.venv",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "extraResources": [
        {
          "from": "../win-python",
          "to": "python",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pdb",
            "!**/*.chm",
            "!**/pip/_vendor/**/tests/**",
            "!**/setuptools/tests/**",
            "!**/numpy/tests/**",
            "!**/numpy/_pyinstaller/**",
            "!**/pytest*/**",
            "!**/_pytest/**",
            "!**/.env",
            "!**/.env.*",
            "!**/*.db",
            "!**/secrets.json"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Tevarn",
      "uninstallDisplayName": "Tevarn",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ]
  }
}
